param set-default SIM_GZ_SV_FUNC7 207
param set-default SIM_GZ_SV_MIN7 1000
param set-default SIM_GZ_SV_MAX7 2000
param set-default SIM_GZ_SV_DIS7 1500
param set-default SIM_GZ_SV_FAIL7 1500
param set-default SIM_GZ_SV_MINA7 -90
