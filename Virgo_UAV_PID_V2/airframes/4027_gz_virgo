#!/bin/sh
#
# @name Virgo OMAV (H-Frame Omnidirectional Multi-Rotor UAV)
#
# @type Omnidirectional Multirotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=virgo}

param set-default SIM_GZ_EN 1

# Virgo OMAV Airframe Index (CA_AIRFRAME = 18)
param set-default CA_AIRFRAME 18
param set-default CA_TILTING_TYPE 1

# Direct Horizontal Force & Velocity Controller Tuning (Fully-Actuated H-Frame)
# Fully actuated horizontal force authority (1.0 = full lateral/horizontal authority)
param set-default MC_MAX_FXY 1.0
param set-default MPC_THR_XY_MARG 0.0
param set-default MAN_DEADZONE 0.12
param set-default MC_DES_PITCH_MAX 360.0
param set-default MC_DES_PITCH_MIN -360.0
param set-default MC_DES_ROLL_MAX 360.0
param set-default MC_DES_ROLL_MIN -360.0
param set-default FD_FAIL_R 0
param set-default FD_FAIL_P 0

# Position & Velocity Stiff Gains (Damped Heavy Airframe Tuning 4.56kg)
param set-default MPC_XY_P 2.4
param set-default MPC_XY_VEL_P_ACC 3.2
param set-default MPC_XY_VEL_I_ACC 0.28
param set-default MPC_XY_VEL_D_ACC 0.42
param set-default MPC_XY_ERR_MAX 0.6
param set-default MPC_ACC_HOR_MAX 1.5
param set-default MPC_JERK_AUTO 3.0
param set-default MPC_Z_P 2.0
param set-default MPC_Z_VEL_P_ACC 4.8
param set-default MPC_Z_VEL_D_ACC 0.10

# Rate & Attitude Controller Gains (High-Damping Tuning for 4.56 kg MorphQuad Inertia)
param set-default MC_ROLL_P 4.6
param set-default MC_PITCH_P 4.6
param set-default MC_YAW_P 3.5
param set-default MC_YAW_WEIGHT 1.0
param set-default MC_ROLLRATE_P 0.095
param set-default MC_PITCHRATE_P 0.095
param set-default MC_ROLLRATE_I 0.10
param set-default MC_PITCHRATE_I 0.10
param set-default MC_ROLLRATE_D 0.0055
param set-default MC_PITCHRATE_D 0.0060
param set-default MC_YAWRATE_P 0.20
param set-default MC_YAWRATE_I 0.05
param set-default MC_YAWRATE_D 0.0035
param set-default MC_YR_INT_LIM 0.20
param set-default MC_YAWRATE_MAX 120.0
param set-default MC_YAW_TQ_CUTOFF 20.0

param set-default CA_ROTOR_COUNT 8
param set-default CA_SV_CS_COUNT 8

# ==============================================================================
# Square Symmetric Frame Geometry: Lx = 0.20m, Ly = 0.20m
# ==============================================================================
# Arm 0: Front-Left (+0.20, +0.20, 0.0)
param set-default CA_ROTOR0_PX 0.20
param set-default CA_ROTOR0_PY 0.20
param set-default CA_ROTOR0_PZ 0.0
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX 0.20
param set-default CA_ROTOR1_PY 0.20
param set-default CA_ROTOR1_PZ 0.0
param set-default CA_ROTOR1_KM -0.05

# Arm 1: Back-Left (-0.20, +0.20, 0.0)
param set-default CA_ROTOR2_PX -0.20
param set-default CA_ROTOR2_PY 0.20
param set-default CA_ROTOR2_PZ 0.0
param set-default CA_ROTOR2_KM 0.05

param set-default CA_ROTOR3_PX -0.20
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_PZ 0.0
param set-default CA_ROTOR3_KM -0.05

# Arm 2: Back-Right (-0.20, -0.20, 0.0)
param set-default CA_ROTOR4_PX -0.20
param set-default CA_ROTOR4_PY -0.20
param set-default CA_ROTOR4_PZ 0.0
param set-default CA_ROTOR4_KM 0.05

param set-default CA_ROTOR5_PX -0.20
param set-default CA_ROTOR5_PY -0.20
param set-default CA_ROTOR5_PZ 0.0
param set-default CA_ROTOR5_KM -0.05

# Arm 3: Front-Right (+0.20, -0.20, 0.0)
param set-default CA_ROTOR6_PX 0.20
param set-default CA_ROTOR6_PY -0.20
param set-default CA_ROTOR6_PZ 0.0
param set-default CA_ROTOR6_KM 0.05

param set-default CA_ROTOR7_PX 0.20
param set-default CA_ROTOR7_PY -0.20
param set-default CA_ROTOR7_PZ 0.0
param set-default CA_ROTOR7_KM -0.05

# Map ESC channels to Gazebo Motor Model (101..108)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105
