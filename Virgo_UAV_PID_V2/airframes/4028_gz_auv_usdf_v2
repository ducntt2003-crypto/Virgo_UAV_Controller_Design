#!/bin/sh
#
# @name AUV_USDF_V2 OMAV (H-Frame Omnidirectional Multi-Rotor UAV)
#
# @type Omnidirectional Multirotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=auv_usdf_v2}
export PX4_GZ_MODEL_POSE="0,0,0.35,0,0,1.5707963"

param set-default SIM_GZ_EN 1

# Virgo OMAV Airframe Index (CA_AIRFRAME = 18)
param set-default CA_AIRFRAME 18
param set-default CA_TILTING_TYPE 1

# Direct Horizontal Force & Velocity Controller Tuning (Fully-Actuated H-Frame)
# Fully actuated horizontal force authority (1.0 = full lateral/horizontal authority)
param set-default MC_MAX_FXY 1.0
param set-default MPC_THR_XY_MARG 0.0
param set-default MAN_DEADZONE 0.12
param set-default MC_DES_PITCH_MAX 360.0
param set-default MC_DES_PITCH_MIN -360.0
param set-default MC_DES_ROLL_MAX 360.0
param set-default MC_DES_ROLL_MIN -360.0
param set-default FD_FAIL_R 0
param set-default FD_FAIL_P 0

# Position & Velocity Stiff Gains (Anti-Drift & Anti-Windup Pipeline)
param set-default MPC_XY_P 1.4
param set-default MPC_XY_VEL_P_ACC 1.6
param set-default MPC_XY_VEL_I_ACC 0.35
param set-default MPC_XY_VEL_D_ACC 0.28
param set-default MPC_XY_ERR_MAX 1.0
param set-default MPC_ACC_HOR_MAX 1.5
param set-default MPC_JERK_AUTO 3.0
param set-default MPC_Z_P 1.8
param set-default MPC_Z_VEL_P_ACC 5.5

# Rate & Attitude Controller Gains (Tuned for Hybrid Coaxial + Servo Vectoring)
param set-default MC_ROLL_P 6.8
param set-default MC_PITCH_P 6.8
param set-default MC_YAW_P 2.6
param set-default MC_YAW_WEIGHT 1.0
param set-default MC_ROLLRATE_P 0.16
param set-default MC_PITCHRATE_P 0.16
param set-default MC_ROLLRATE_I 0.15
param set-default MC_PITCHRATE_I 0.15
param set-default MC_ROLLRATE_D 0.003
param set-default MC_PITCHRATE_D 0.003
param set-default MC_YAWRATE_P 0.16
param set-default MC_YAWRATE_I 0.025
param set-default MC_YAWRATE_D 0.003
param set-default MC_YR_INT_LIM 0.15
param set-default MC_YAWRATE_MAX 120.0
param set-default MC_YAW_TQ_CUTOFF 30.0

param set-default CA_ROTOR_COUNT 8
param set-default CA_SV_CS_COUNT 8

# ==============================================================================
# Square Symmetric Frame Geometry: Lx = 0.25m, Ly = 0.25m
# ==============================================================================
# Arm 0: Front-Left (+0.25, +0.25, 0.0)
param set-default CA_ROTOR0_PX 0.25
param set-default CA_ROTOR0_PY 0.25
param set-default CA_ROTOR0_PZ 0.0
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX 0.25
param set-default CA_ROTOR1_PY 0.25
param set-default CA_ROTOR1_PZ 0.0
param set-default CA_ROTOR1_KM -0.05

# Arm 1: Back-Left (-0.25, +0.25, 0.0)
param set-default CA_ROTOR2_PX -0.25
param set-default CA_ROTOR2_PY 0.25
param set-default CA_ROTOR2_PZ 0.0
param set-default CA_ROTOR2_KM 0.05

param set-default CA_ROTOR3_PX -0.25
param set-default CA_ROTOR3_PY 0.25
param set-default CA_ROTOR3_PZ 0.0
param set-default CA_ROTOR3_KM -0.05

# Arm 2: Back-Right (-0.25, -0.25, 0.0)
param set-default CA_ROTOR4_PX -0.25
param set-default CA_ROTOR4_PY -0.25
param set-default CA_ROTOR4_PZ 0.0
param set-default CA_ROTOR4_KM 0.05

param set-default CA_ROTOR5_PX -0.25
param set-default CA_ROTOR5_PY -0.25
param set-default CA_ROTOR5_PZ 0.0
param set-default CA_ROTOR5_KM -0.05

# Arm 3: Front-Right (+0.25, -0.25, 0.0)
param set-default CA_ROTOR6_PX 0.25
param set-default CA_ROTOR6_PY -0.25
param set-default CA_ROTOR6_PZ 0.0
param set-default CA_ROTOR6_KM 0.05

param set-default CA_ROTOR7_PX 0.25
param set-default CA_ROTOR7_PY -0.25
param set-default CA_ROTOR7_PZ 0.0
param set-default CA_ROTOR7_KM -0.05

# Map ESC channels to Gazebo Motor Model (101..108)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105
param set-default SIM_GZ_EC_FUNC6 106
param set-default SIM_GZ_EC_FUNC7 107
param set-default SIM_GZ_EC_FUNC8 108

param set-default SIM_GZ_EC_MIN1 100
param set-default SIM_GZ_EC_MIN2 100
param set-default SIM_GZ_EC_MIN3 100
param set-default SIM_GZ_EC_MIN4 100
param set-default SIM_GZ_EC_MIN5 100
param set-default SIM_GZ_EC_MIN6 100
param set-default SIM_GZ_EC_MIN7 100
param set-default SIM_GZ_EC_MIN8 100

param set-default SIM_GZ_EC_MAX1 1200
param set-default SIM_GZ_EC_MAX2 1200
param set-default SIM_GZ_EC_MAX3 1200
param set-default SIM_GZ_EC_MAX4 1200
param set-default SIM_GZ_EC_MAX5 1200
param set-default SIM_GZ_EC_MAX6 1200
param set-default SIM_GZ_EC_MAX7 1200
param set-default SIM_GZ_EC_MAX8 1200

# Map 8 Servos to Gazebo JointPositionController (channels 201..208)
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_MINA1 -720
param set-default SIM_GZ_SV_MAXA1 720

param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_MINA2 -720
param set-default SIM_GZ_SV_MAXA2 720

param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_MINA3 -720
param set-default SIM_GZ_SV_MAXA3 720

param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_MINA4 -720
param set-default SIM_GZ_SV_MAXA4 720

param set-default SIM_GZ_SV_FUNC5 205
param set-default SIM_GZ_SV_MINA5 -720
param set-default SIM_GZ_SV_MAXA5 720

param set-default SIM_GZ_SV_FUNC6 206
param set-default SIM_GZ_SV_MINA6 -720
param set-default SIM_GZ_SV_MAXA6 720

param set-default SIM_GZ_SV_FUNC7 207
param set-default SIM_GZ_SV_MINA7 -720
param set-default SIM_GZ_SV_MAXA7 720

param set-default SIM_GZ_SV_FUNC8 208
param set-default SIM_GZ_SV_MINA8 -720
param set-default SIM_GZ_SV_MAXA8 720

# Flight performance tuning
param set-default MPC_THR_HOVER 0.35
param set-default MPC_THR_MIN 0.10
param set-default MPC_THR_MAX 1.0
param set-default MPC_Z_VEL_MAX_UP 2.0
param set-default MPC_Z_VEL_MAX_DN 1.5
param set-default MPC_TKO_SPEED 1.2
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
param set-default COM_RCL_EXCEPT 4
param set-default COM_RC_IN_MODE 1
param set-default CBRK_SUPPLY_CHK 894281
param set-default CBRK_IO_SAFETY 22027
param set-default COM_ARM_WO_GPS 1
param set-default EKF2_MAG_TYPE 1
